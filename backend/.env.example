# Copy to .env and fill in. NEVER commit .env.
ENVIRONMENT=development

# PostgreSQL (recommended / shared environments). Replace USER, PASSWORD, DB name.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/market_strategist

# Quick local alternative (SQLite, development only):
DATABASE_URL=sqlite:///./dev.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Development-only convenience. Use Alembic migrations for shared environments.
AUTO_CREATE_TABLES=false


# Strategy engine (default mock provider requires no API key)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=20
MAX_RECOMMENDATIONS=3
SCORING_WEIGHTS_JSON=
